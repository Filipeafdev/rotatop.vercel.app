{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile with role-based access for drivers and fleet managers",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["motorista", "gestor"] },
        "phone": { "type": "string" },
        "vehiclePlate": { "type": "string" },
        "homeAddress": { "type": "string" },
        "accessPassword": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Vehicle": {
      "title": "Vehicle",
      "description": "Fleet vehicle with fuel consumption parameters",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "plate": { "type": "string" },
        "model": { "type": "string" },
        "brand": { "type": "string" },
        "avgKmLiter": { "type": "number" },
        "fuelType": { "type": "string" },
        "status": { "type": "string", "enum": ["ativo", "manutencao", "inativo"] },
        "assignedDriverName": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "plate", "model", "avgKmLiter"]
    },
    "Route": {
      "title": "Route",
      "description": "A logistics delivery route with financial & odometer metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "driverId": { "type": "string" },
        "driverName": { "type": "string" },
        "vehiclePlate": { "type": "string" },
        "date": { "type": "string" },
        "status": { "type": "string", "enum": ["planejada", "em_andamento", "concluida", "cancelada", "aguardando_exclusao"] },
        "startAddress": { "type": "string" },
        "endAddress": { "type": "string" },
        "productiveKm": { "type": "number" },
        "unproductiveKm": { "type": "number" },
        "totalKm": { "type": "number" },
        "avgKmLiter": { "type": "number" },
        "fuelPrice": { "type": "number" },
        "estimatedFuelCost": { "type": "number" },
        "totalWeight": { "type": "number" },
        "totalValue": { "type": "number" },
        "deliveredWeight": { "type": "number" },
        "deliveredValue": { "type": "number" },
        "manifestImages": { "type": "array", "items": { "type": "string" } },
        "odometerStartHome": { "type": "number" },
        "odometerStartCompany": { "type": "number" },
        "odometerEndCompany": { "type": "number" },
        "odometerEndHome": { "type": "number" },
        "odometerCalculated": { "type": "boolean" },
        "deletionRequestId": { "type": "string" },
        "deletionReason": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "driverId", "date", "status"]
    },
    "Stop": {
      "title": "Stop",
      "description": "An individual delivery stop in the manifest",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "routeId": { "type": "string" },
        "driverId": { "type": "string" },
        "sequenceIndex": { "type": "number" },
        "clientName": { "type": "string" },
        "address": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "orderValue": { "type": "number" },
        "totalWeight": { "type": "number" },
        "isPriority": { "type": "boolean" },
        "paymentMethod": { "type": "string", "enum": ["a_vista", "a_prazo"] },
        "notes": { "type": "string" },
        "status": { "type": "string", "enum": ["pendente", "entregue", "cancelada", "reentregar"] },
        "cancelReason": { "type": "string" },
        "deliveredAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "routeId", "clientName", "address", "orderValue", "totalWeight", "status"]
    },
    "MaintenanceRecord": {
      "title": "MaintenanceRecord",
      "description": "Vehicle maintenance record logged by driver or manager for cost & km analysis",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "vehiclePlate": { "type": "string" },
        "driverId": { "type": "string" },
        "driverName": { "type": "string" },
        "type": { "type": "string" },
        "customTypeLabel": { "type": "string" },
        "cost": { "type": "number" },
        "kmAtMaintenance": { "type": "number" },
        "date": { "type": "string" },
        "workshopName": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "vehiclePlate", "cost", "kmAtMaintenance", "date"]
    },
    "CompanyBase": {
      "title": "CompanyBase",
      "description": "Company distribution center or warehouse base configured by manager",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "address": { "type": "string" },
        "coords": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          },
          "required": ["lat", "lng"]
        },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "address", "coords"]
    },
    "ClosureDeletionRequest": {
      "title": "ClosureDeletionRequest",
      "description": "Workflow request to delete a daily closure awaiting manager approval",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "routeId": { "type": "string" },
        "date": { "type": "string" },
        "driverId": { "type": "string" },
        "driverName": { "type": "string" },
        "vehiclePlate": { "type": "string" },
        "totalKm": { "type": "number" },
        "deliveredValue": { "type": "number" },
        "reason": { "type": "string" },
        "status": { "type": "string", "enum": ["pendente", "aprovada", "rejeitada"] },
        "requestedAt": { "type": "string" },
        "resolvedAt": { "type": "string" },
        "resolvedBy": { "type": "string" },
        "managerNotes": { "type": "string" }
      },
      "required": ["id", "routeId", "reason", "status", "requestedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles for authenticated drivers and managers"
    },
    "/company_bases/{baseId}": {
      "schema": "CompanyBase",
      "description": "Company distribution center / warehouse base locations"
    },
    "/vehicles/{vehicleId}": {
      "schema": "Vehicle",
      "description": "Fleet vehicles collection"
    },
    "/routes/{routeId}": {
      "schema": "Route",
      "description": "Delivery routes and manifests"
    },
    "/routes/{routeId}/stops/{stopId}": {
      "schema": "Stop",
      "description": "Delivery stops under a route"
    },
    "/maintenance/{recordId}": {
      "schema": "MaintenanceRecord",
      "description": "Fleet vehicle maintenance records"
    },
    "/closure_deletion_requests/{requestId}": {
      "schema": "ClosureDeletionRequest",
      "description": "Closure deletion requests awaiting manager approval"
    }
  }
}
